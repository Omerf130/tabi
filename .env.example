Copy to `.env.local` for local development. Do not commit real values.

MONGODB_URI=

# HMAC signing secret for stale-safe trip date change previews (server-only)
TABI_PREVIEW_TOKEN_SECRET=

# Vercel Blob private storage (Trip cover image)
BLOB_READ_WRITE_TOKEN=

# Google Places API (New) — server-side only
GOOGLE_PLACES_API_KEY=

# Google OAuth (Sign-In) — server-side only
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# WeatherAPI.com — server-side only
WEATHER_API_KEY=

# Web Push (VAPID) — public key for browser PushManager.subscribe (client)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Web Push (VAPID) — server-only, required from N3 onward for sending
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional dev-only guard for POST /api/dev/push-deliver-due (N3 manual delivery)
# PUSH_DELIVERY_DEV_SECRET=

# External scheduler (cron-job.org, etc.) — POST /api/internal/reminder-notifications
PUSH_SCHEDULER_SECRET=
